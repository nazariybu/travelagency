# Generated by Terraform (terraform/envs/${env}). Do not edit by hand:
# change terraform/envs/${env}/terraform.tfvars and run "terraform apply".
%{ for group in groups ~}

[${group}]
%{ for name, server in servers ~}
%{ if server.group == group ~}
${name} ansible_host=${server.ip}%{ if server.private_ip != "" } private_ip=${server.private_ip}%{ endif }
%{ endif ~}
%{ endfor ~}
%{ endfor ~}

[all:vars]
${join("\n", [for key, value in all_vars : "${key}=${value}"])}