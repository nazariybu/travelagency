# Generated by Terraform (terraform/envs/eks/k8s-generated.tf). Do not edit by hand,
# and do not commit it (.gitignore). Applied with the rest: kubectl apply -f k8s/

# "mysql" inside the cluster = the RDS server. An ExternalName Service is just a DNS alias (CNAME):
# the app connects to mysql:3306 (k8s/10-configmap.yaml) and never needs to know the long RDS address.
apiVersion: v1
kind: Service
metadata:
  name: mysql
  namespace: travelagency
  labels:
    app.kubernetes.io/name: mysql
spec:
  type: ExternalName
  externalName: ${db_host}
---
# The way in from the internet. type LoadBalancer = Kubernetes asks AWS for a real load balancer.
# The annotation says which kind: NLB (Network Load Balancer, fast, cheap, works on TCP).
# loadBalancerSourceRanges: Kubernetes opens port 80 on the nodes only for these addresses.
apiVersion: v1
kind: Service
metadata:
  name: travelagency
  namespace: travelagency
  labels:
    app.kubernetes.io/name: travelagency
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: nlb
spec:
  type: LoadBalancer
  selector:
    app.kubernetes.io/name: travelagency
  ports:
    - name: http
      port: 80
      targetPort: http
  loadBalancerSourceRanges:
%{ for cidr in allow_cidrs ~}
    - ${cidr}
%{ endfor ~}