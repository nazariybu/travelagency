
# Managed by Ansible (monitoring.yml). Targets come from inventory.ini.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

# Firing alerts go to Alertmanager, it sends them to Telegram
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels: { instance: "{{ inventory_hostname }}" }

  # Alertmanager itself: if it is down, TargetDown shows it in Prometheus
  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
        labels: { instance: "{{ inventory_hostname }}" }

  # Loki itself (in the same compose): if it is down, TargetDown fires
  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]
        labels: { instance: "{{ inventory_hostname }}" }

  # Grafana Alloy (sends logs to Loki) on every server from logging.yml.
  # If Alloy stops, logs stop and TargetDown fires
  - job_name: alloy
    static_configs:
{% for host in groups['app'] + groups['lb'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:{{ alloy_port }}"]
        labels: { instance: "{{ host }}" }
{% endfor %}

  # CPU, RAM, disk, network of every server (node_exporter)
  - job_name: node
    static_configs:
{% for host in groups['all'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:9100"]
        labels: { instance: "{{ host }}" }
{% endfor %}

  # JVM heap, GC, threads and Tomcat requests (JMX exporter inside Tomcat)
  - job_name: tomcat
    static_configs:
{% for host in groups['app'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:{{ jmx_exporter_port }}"]
        labels: { instance: "{{ host }}" }
{% endfor %}

  # MySQL connections, queries, slow queries (mysqld_exporter)
  - job_name: mysql
    static_configs:
{% for host in groups['db'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:9104"]
        labels: { instance: "{{ host }}" }
{% endfor %}

  # Redis memory, clients, keys (redis_exporter in the same compose)
  - job_name: redis
    static_configs:
      - targets: ["redis-exporter:9121"]
        labels: { instance: "{{ groups['redis'][0] }}" }

  # CPU, RAM, disk of every LXC from the Proxmox API (pve-exporter in the same compose)
  - job_name: pve
    metrics_path: /pve
    params:
      target: ["{{ proxmox_host }}"]
      cluster: ["1"]
      node: ["1"]
    static_configs:
      - targets: ["pve-exporter:9221"]
        labels: { instance: proxmox }
    metric_relabel_configs:
      # Proxmox returns every LXC/VM. Keep names only for servers from inventory.ini,
      # so lxc:cpu_used:percent has no other containers (SonarQube, tests, ...)
      - source_labels: [name]
        regex: "{{ groups['all'] | join('|') }}"
        target_label: __tmp_keep
        replacement: "yes"
      - source_labels: [__name__, __tmp_keep]
        regex: "pve_guest_info;"
        action: drop

  # The site from the outside: through the load balancer and on each app node
  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["http://{{ hostvars[groups['lb'][0]].ansible_host }}:{{ lb_port }}/form-login"]
        labels: { instance: "{{ groups['lb'][0] }}" }
{% for host in groups['app'] %}
      - targets: ["http://{{ hostvars[host].ansible_host }}:{{ app_port }}/form-login"]
        labels: { instance: "{{ host }}" }
{% endfor %}
      # Vault health: 200 only when it is unsealed. Sealed = 503 = SiteDown alert in Telegram
      - targets: ["{{ vault_url }}/v1/sys/health"]
        labels: { instance: "{{ groups['vault'][0] }}" }
    relabel_configs:
      # Send the URL to blackbox as ?target=..., keep it as the "url" label
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: url
      - target_label: __address__
        replacement: blackbox:9115