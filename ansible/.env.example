# Example of the secrets file.
#   1. Copy it:   cp .env.example .env
#   2. Put your real values into .env
#   3. Load it:   set -a; source .env; set +a
# The .env file is in .gitignore, so it never goes to GitHub.

# Password of the MySQL user "travel" (used by app.yml)
DB_PASSWORD=change_me

# Secret of the Proxmox API token (used by provision.yml)
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
