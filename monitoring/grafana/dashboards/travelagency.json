      "description": "Full HTTP request time measured by blackbox"
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
