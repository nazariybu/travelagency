      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(tomcat_requestcount_total[5m]))",
          "legendFormat": "{{instance}}"
        }
