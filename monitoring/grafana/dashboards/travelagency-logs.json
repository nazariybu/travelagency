{
  "uid": "travelagency-logs",
  "title": "TravelAgency logs",
  "tags": [
    "travelagency",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Logs from Loki: nginx on vm-lb and Tomcat on the app nodes (sent by Grafana Alloy)",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "instance",
        "label": "App node",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "instance",
          "stream": "{job=\"tomcat\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({job=\"tomcat\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search in app logs",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines per second (after filtering)",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "How many log lines every server sends to Loki. A sudden jump = something is wrong (errors, a loop).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (job, instance) (rate({job=~\".+\"}[$__auto]))",
          "legendFormat": "{{job}} {{instance}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hibernate SQL lines dropped by Alloy (per second)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "hibernate.show_sql=true prints every SQL query. Alloy drops these lines (stage.drop) so Loki is not flooded. Metric from Prometheus (job alloy).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(loki_process_dropped_lines_total{reason=\"hibernate_sql\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "nginx (vm-lb): every request through the load balancer",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by HTTP status",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Counted from the nginx JSON access log. 2xx/3xx ok, 4xx client errors (wrong URL), 5xx server errors (502 = Tomcat down).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({job=\"nginx\", type=\"access\"} | json | __error__=\"\" [$__auto]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per app node (upstream)",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Which Tomcat answered. .101 = vm-app, .105 = vm-app2. With round-robin both bars must be about equal (this is how ip_hash was found in the k6 test).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (upstream) (count_over_time({job=\"nginx\", type=\"access\"} | json | __error__=\"\" | upstream != \"\" [$__auto]))",
          "legendFormat": "{{upstream}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 response time per app node",
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "95% of requests were faster than this. Taken from request_time in the nginx log.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {job=\"nginx\", type=\"access\"} | json | __error__=\"\" | upstream != \"\" | unwrap request_time | __error__=\"\" [$__auto]) by (upstream)",
          "legendFormat": "{{upstream}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Slow (> 1 s) or failed (5xx) requests",
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Each line: status, time, method, URL, which node answered.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"nginx\", type=\"access\"} | json | __error__=\"\" | status >= 500 or request_time > 1 | line_format \"{{.status}}  {{.request_time}}s  {{.method}} {{.uri}}  -> {{.upstream}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "nginx error log",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "upstream timed out, connect() failed (an app node is down) ...",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"nginx\", type=\"error\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tomcat + application (vm-app, vm-app2)",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "ERROR / WARN lines per node",
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Levels from logback (ERROR, WARN) and Tomcat (SEVERE, WARNING).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance, level) (count_over_time({job=\"tomcat\", instance=~\"$instance\"} | regexp `^\\S+ \\S+ (?P<level>ERROR|WARN|SEVERE|WARNING) ` [$__auto]))",
          "legendFormat": "{{instance}} {{level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed logins",
      "id": 12,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "SecurityController writes WARN \"Exiting login with POST - failed login\".",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({job=\"tomcat\", instance=~\"$instance\"} |= \"failed login\" [$__auto]))",
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Errors and exceptions",
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Stack traces are glued into one entry by Alloy (stage.multiline). Click a line to see all of it.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"tomcat\", instance=~\"$instance\"} |~ \" (ERROR|SEVERE) |Exception\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "All application logs (search box at the top)",
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"tomcat\", instance=~\"$instance\"} |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
